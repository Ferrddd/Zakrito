# Параметры docker compose (копируйте в .env)
START=2026-06-01        # с какого момента проигрывать историю
STEPS=500               # сколько циклов
EVERY=6                 # шаг по сетке (6 = раз в час)
SLEEP=3                 # пауза между циклами, сек (чтобы UI успевал показывать)
UI_URL=http://ui:3000/api/update   # ДОПУЩЕНИЕ: путь эндпоинта UI — сверить с ui/server.js
TRAIN_RELIABILITY=1     # обучить модель ΔP агента надёжности (best-effort)
QUALITY_HORIZON=6       # горизонт обучения агента качества (6 = 60 мин); пусто = все из config.yaml
